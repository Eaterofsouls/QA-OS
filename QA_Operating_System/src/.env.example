# =============================================================
# AI QA Operating System — Environment Variables
# Copy this file to .env and fill in real values
# =============================================================

# ---- Neo4j (PACK-01) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qa-os-dev-password
NEO4J_DATABASE=neo4j

# ---- PostgreSQL (PACK-01) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qaos
POSTGRES_USER=qaos
POSTGRES_PASSWORD=qa-os-dev-password
DATABASE_URL=postgresql://qaos:qa-os-dev-password@localhost:5432/qaos

# ---- MinIO / S3-compatible Object Storage (PACK-01) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=qa-os-traces
S3_REGION=us-east-1

# ---- Temporal (PACK-01, feature-flagged) ----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=qa-os
TEMPORAL_ENABLED=false   # STAGED: set to true only when trigger fires

# ---- WorkOS Auth (PACK-03) ----
WORKOS_API_KEY=sk_test_REPLACE_WITH_REAL_KEY
WORKOS_CLIENT_ID=client_REPLACE_WITH_REAL_ID
# STAGED: Live SSO/SCIM configured at first design-partner onboarding

# ---- LiteLLM Gateway (PACK-03) ----
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-litellm-dev-key
LITELLM_IMAGE_TAG=v1.35.0  # pinned, signed tag — DO NOT change without cosign verification

# ---- Jira Connector (PACK-02) ----
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=REPLACE_WITH_JIRA_API_TOKEN

# ---- GitHub Connector (PACK-02) ----
GITHUB_APP_ID=REPLACE_WITH_APP_ID
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# ---- Slack Connector (PACK-02) ----
SLACK_BOT_TOKEN=xoxb-REPLACE_WITH_BOT_TOKEN
SLACK_SIGNING_SECRET=REPLACE_WITH_SIGNING_SECRET
SLACK_DEFAULT_CHANNEL=#qa-os-notifications

# ---- Observability (PACK-03/05) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE
LANGFUSE_SECRET_KEY=sk-lf-REPLACE
LANGFUSE_HOST=http://localhost:3001  # self-hosted (staged)

# ---- LLM Models (PACK-03) ----
# All calls go through LiteLLM — never use raw provider SDKs
OPENAI_API_KEY=sk-REPLACE_WITH_OPENAI_KEY
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_ANTHROPIC_KEY

# ---- Per-tenant cost ceiling (PACK-03) ----
DEFAULT_COST_CEILING_USD=10.00

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=dev-secret-key-change-in-production
APP_PORT=8000
DEBUG=true

# ---- Feature Flags ----
FEATURE_TEMPORAL=false
FEATURE_GRAPHITI=false          # staged: fires when temporal-versioning query needed
FEATURE_RERANKER=false          # staged: fires when retrieval quality drops below threshold
FEATURE_SELF_HOSTED_LANGFUSE=false  # staged: fires at first paid customer
FEATURE_LIVE_SSO=false          # staged: first design-partner onboarding
